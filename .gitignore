# Secrets et données personnelles — jamais versionnés.
config.json
seen.json
watchlist.json
ignored.json

# Certificats deposes depuis l'interface : cle privee du client Deluge.
certs/

# Toutes les variantes produites par les protections du stockage : copies de
# secours, mises en quarantaine, écritures atomiques, sauvegardes datées.
# Elles contiennent exactement les mêmes données que les fichiers ci-dessus.
*.backup
*.corrompu-*
*.tmp
*.avant-*

# Volumes de données alternatifs (TROUVEUR_DATA_DIR)
data/

.cache/
__pycache__/
*.pyc

# addon/app/ est volontairement versionne : Home Assistant clone le depot puis
# construit l'image, et le Dockerfile y prend le code. Il est regenere par
# « python package_addon.py », qui refuse d'y copier une cle ou une liste.
.tv-hass-data
